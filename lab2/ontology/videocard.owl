<?xml version="1.0"?>
<rdf:RDF xmlns="https://example.org/ontologies/videocard#"
     xml:base="https://example.org/ontologies/videocard"
     xmlns:vc="https://example.org/ontologies/videocard#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="https://example.org/ontologies/videocard">
        <owl:versionIRI rdf:resource="https://example.org/ontologies/videocard/1.0.0"/>
        <rdfs:comment xml:lang="ru">Учебная онтология предметной области «Дискретные видеокарты», версия 1.0.0.</rdfs:comment>
        <rdfs:label xml:lang="ru">Онтология дискретных видеокарт</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://example.org/ontologies/videocard#gpuProducedBy -->

    <owl:ObjectProperty rdf:about="https://example.org/ontologies/videocard#gpuProducedBy">
        <rdfs:domain rdf:resource="https://example.org/ontologies/videocard#GPUModel"/>
        <rdfs:range rdf:resource="https://example.org/ontologies/videocard#Manufacturer"/>
        <rdfs:comment xml:lang="ru">Связывает модель GPU с производителем.</rdfs:comment>
        <rdfs:label xml:lang="ru">GPU выпущен производителем</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontologies/videocard#hasArchitecture -->

    <owl:ObjectProperty rdf:about="https://example.org/ontologies/videocard#hasArchitecture">
        <rdfs:domain rdf:resource="https://example.org/ontologies/videocard#GPUModel"/>
        <rdfs:range rdf:resource="https://example.org/ontologies/videocard#GPUArchitecture"/>
        <rdfs:comment xml:lang="ru">Связывает модель GPU с архитектурой GPU.</rdfs:comment>
        <rdfs:label xml:lang="ru">имеет архитектуру</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontologies/videocard#hasCooling -->

    <owl:ObjectProperty rdf:about="https://example.org/ontologies/videocard#hasCooling">
        <rdfs:domain rdf:resource="https://example.org/ontologies/videocard#VideoCardModel"/>
        <rdfs:range rdf:resource="https://example.org/ontologies/videocard#CoolingSystem"/>
        <rdfs:comment xml:lang="ru">Связывает модель видеокарты с системой охлаждения.</rdfs:comment>
        <rdfs:label xml:lang="ru">имеет охлаждение</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontologies/videocard#hasInterface -->

    <owl:ObjectProperty rdf:about="https://example.org/ontologies/videocard#hasInterface">
        <rdfs:domain rdf:resource="https://example.org/ontologies/videocard#VideoCardModel"/>
        <rdfs:range rdf:resource="https://example.org/ontologies/videocard#ConnectionInterface"/>
        <rdfs:comment xml:lang="ru">Связывает модель видеокарты с интерфейсом подключения.</rdfs:comment>
        <rdfs:label xml:lang="ru">имеет интерфейс</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontologies/videocard#hasMemory -->

    <owl:ObjectProperty rdf:about="https://example.org/ontologies/videocard#hasMemory">
        <rdfs:domain rdf:resource="https://example.org/ontologies/videocard#VideoCardModel"/>
        <rdfs:range rdf:resource="https://example.org/ontologies/videocard#MemoryConfiguration"/>
        <rdfs:comment xml:lang="ru">Связывает модель видеокарты с конфигурацией видеопамяти.</rdfs:comment>
        <rdfs:label xml:lang="ru">имеет память</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontologies/videocard#hasMemoryType -->

    <owl:ObjectProperty rdf:about="https://example.org/ontologies/videocard#hasMemoryType">
        <rdfs:domain rdf:resource="https://example.org/ontologies/videocard#MemoryConfiguration"/>
        <rdfs:range rdf:resource="https://example.org/ontologies/videocard#MemoryType"/>
        <rdfs:comment xml:lang="ru">Связывает конфигурацию видеопамяти с типом памяти.</rdfs:comment>
        <rdfs:label xml:lang="ru">имеет тип памяти</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontologies/videocard#hasPurpose -->

    <owl:ObjectProperty rdf:about="https://example.org/ontologies/videocard#hasPurpose">
        <rdfs:domain rdf:resource="https://example.org/ontologies/videocard#VideoCardModel"/>
        <rdfs:range rdf:resource="https://example.org/ontologies/videocard#Purpose"/>
        <rdfs:comment xml:lang="ru">Связывает модель видеокарты с назначением.</rdfs:comment>
        <rdfs:label xml:lang="ru">имеет назначение</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontologies/videocard#hasVideoOutput -->

    <owl:ObjectProperty rdf:about="https://example.org/ontologies/videocard#hasVideoOutput">
        <rdfs:domain rdf:resource="https://example.org/ontologies/videocard#VideoCardModel"/>
        <rdfs:range rdf:resource="https://example.org/ontologies/videocard#VideoOutput"/>
        <rdfs:comment xml:lang="ru">Связывает модель видеокарты с поддерживаемым видеовыходом.</rdfs:comment>
        <rdfs:label xml:lang="ru">имеет видеовыход</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontologies/videocard#producedByManufacturer -->

    <owl:ObjectProperty rdf:about="https://example.org/ontologies/videocard#producedByManufacturer">
        <rdfs:domain rdf:resource="https://example.org/ontologies/videocard#VideoCardModel"/>
        <rdfs:range rdf:resource="https://example.org/ontologies/videocard#Manufacturer"/>
        <rdfs:comment xml:lang="ru">Связывает модель видеокарты с производителем.</rdfs:comment>
        <rdfs:label xml:lang="ru">выпущена производителем</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontologies/videocard#usesGPU -->

    <owl:ObjectProperty rdf:about="https://example.org/ontologies/videocard#usesGPU">
        <rdfs:domain rdf:resource="https://example.org/ontologies/videocard#VideoCardModel"/>
        <rdfs:range rdf:resource="https://example.org/ontologies/videocard#GPUModel"/>
        <rdfs:comment xml:lang="ru">Связывает модель видеокарты с используемой моделью GPU.</rdfs:comment>
        <rdfs:label xml:lang="ru">использует GPU</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://example.org/ontologies/videocard#busWidthBit -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontologies/videocard#busWidthBit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ontologies/videocard#MemoryConfiguration"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="ru">Ширина шины памяти в битах.</rdfs:comment>
        <rdfs:label xml:lang="ru">ширина шины, бит</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontologies/videocard#fanCount -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontologies/videocard#fanCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ontologies/videocard#CoolingSystem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="ru">Число вентиляторов системы охлаждения, шт.</rdfs:comment>
        <rdfs:label xml:lang="ru">число вентиляторов</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontologies/videocard#frequencyMHz -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontologies/videocard#frequencyMHz">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ontologies/videocard#GPUModel"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</xsd:minExclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="ru">Частота модели GPU в МГц (десятичное число больше 0).</rdfs:comment>
        <rdfs:label xml:lang="ru">частота, МГц</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontologies/videocard#lengthMM -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontologies/videocard#lengthMM">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ontologies/videocard#VideoCardModel"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</xsd:minExclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="ru">Длина платы в мм (десятичное число больше 0).</rdfs:comment>
        <rdfs:label xml:lang="ru">длина, мм</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontologies/videocard#name -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontologies/videocard#name">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/ontologies/videocard#ConnectionInterface"/>
                    <rdf:Description rdf:about="https://example.org/ontologies/videocard#GPUArchitecture"/>
                    <rdf:Description rdf:about="https://example.org/ontologies/videocard#GPUModel"/>
                    <rdf:Description rdf:about="https://example.org/ontologies/videocard#Manufacturer"/>
                    <rdf:Description rdf:about="https://example.org/ontologies/videocard#MemoryType"/>
                    <rdf:Description rdf:about="https://example.org/ontologies/videocard#Purpose"/>
                    <rdf:Description rdf:about="https://example.org/ontologies/videocard#VideoCardModel"/>
                    <rdf:Description rdf:about="https://example.org/ontologies/videocard#VideoOutput"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ru">Название сущности (строка, единица отсутствует).</rdfs:comment>
        <rdfs:label xml:lang="ru">название</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontologies/videocard#powerW -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontologies/videocard#powerW">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ontologies/videocard#VideoCardModel"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</xsd:minExclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="ru">Заявленная мощность модели платы в Вт (не рекомендуемая мощность блока питания); десятичное число больше 0.</rdfs:comment>
        <rdfs:label xml:lang="ru">мощность, Вт</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontologies/videocard#volumeGiB -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontologies/videocard#volumeGiB">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ontologies/videocard#MemoryConfiguration"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="ru">Объём видеопамяти в ГиБ.</rdfs:comment>
        <rdfs:label xml:lang="ru">объём, ГиБ</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://example.org/ontologies/videocard#ActiveCooling -->

    <owl:Class rdf:about="https://example.org/ontologies/videocard#ActiveCooling">
        <rdfs:subClassOf rdf:resource="https://example.org/ontologies/videocard#CoolingSystem"/>
        <owl:disjointWith rdf:resource="https://example.org/ontologies/videocard#PassiveCooling"/>
        <rdfs:comment xml:lang="ru">Подкласс «Система охлаждения»; охлаждение с вентилятором.</rdfs:comment>
        <rdfs:label xml:lang="ru">Активное охлаждение</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontologies/videocard#CardWith8GBMemory -->

    <owl:Class rdf:about="https://example.org/ontologies/videocard#CardWith8GBMemory">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/ontologies/videocard#VideoCardModel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/ontologies/videocard#hasMemory"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://example.org/ontologies/videocard#volumeGiB"/>
                                <owl:someValuesFrom>
                                    <rdfs:Datatype>
                                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                        <owl:withRestrictions rdf:parseType="Collection">
                                            <rdf:Description>
                                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</xsd:minInclusive>
                                            </rdf:Description>
                                        </owl:withRestrictions>
                                    </rdfs:Datatype>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="ru">Определяемый класс: модель видеокарты, у которой конфигурация памяти имеет объём не менее 8 ГиБ. Принадлежность выводится reasoner.</rdfs:comment>
        <rdfs:label xml:lang="ru">Карта с памятью от 8 ГиБ</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontologies/videocard#CardWithActiveCooling -->

    <owl:Class rdf:about="https://example.org/ontologies/videocard#CardWithActiveCooling">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/ontologies/videocard#VideoCardModel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/ontologies/videocard#hasCooling"/>
                        <owl:someValuesFrom rdf:resource="https://example.org/ontologies/videocard#ActiveCooling"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="ru">Определяемый класс: модель видеокарты, у которой система охлаждения является активной. Принадлежность выводится reasoner.</rdfs:comment>
        <rdfs:label xml:lang="ru">Карта с активным охлаждением</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontologies/videocard#ConnectionInterface -->

    <owl:Class rdf:about="https://example.org/ontologies/videocard#ConnectionInterface">
        <rdfs:comment xml:lang="ru">Стандарт подключения видеокарты к компьютеру.</rdfs:comment>
        <rdfs:label xml:lang="ru">Интерфейс подключения</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontologies/videocard#CoolingSystem -->

    <owl:Class rdf:about="https://example.org/ontologies/videocard#CoolingSystem">
        <rdfs:subClassOf rdf:resource="https://example.org/ontologies/videocard#ModelComponent"/>
        <rdfs:comment xml:lang="ru">Вариант охлаждения модели карты; подкласс «Компонент модели».</rdfs:comment>
        <rdfs:label xml:lang="ru">Система охлаждения</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontologies/videocard#GPUArchitecture -->

    <owl:Class rdf:about="https://example.org/ontologies/videocard#GPUArchitecture">
        <rdfs:comment xml:lang="ru">Архитектура графического процессора.</rdfs:comment>
        <rdfs:label xml:lang="ru">Архитектура GPU</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontologies/videocard#GPUModel -->

    <owl:Class rdf:about="https://example.org/ontologies/videocard#GPUModel">
        <rdfs:subClassOf rdf:resource="https://example.org/ontologies/videocard#ModelComponent"/>
        <rdfs:comment xml:lang="ru">Модель графического процессора; подкласс «Компонент модели».</rdfs:comment>
        <rdfs:label xml:lang="ru">Модель GPU</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontologies/videocard#Manufacturer -->

    <owl:Class rdf:about="https://example.org/ontologies/videocard#Manufacturer">
        <rdfs:comment xml:lang="ru">Организация, выпускающая модель видеокарты или модель GPU.</rdfs:comment>
        <rdfs:label xml:lang="ru">Производитель</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontologies/videocard#MemoryConfiguration -->

    <owl:Class rdf:about="https://example.org/ontologies/videocard#MemoryConfiguration">
        <rdfs:subClassOf rdf:resource="https://example.org/ontologies/videocard#ModelComponent"/>
        <rdfs:comment xml:lang="ru">Тип, объём и организация памяти; подкласс «Компонент модели».</rdfs:comment>
        <rdfs:label xml:lang="ru">Конфигурация видеопамяти</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontologies/videocard#MemoryType -->

    <owl:Class rdf:about="https://example.org/ontologies/videocard#MemoryType">
        <rdfs:comment xml:lang="ru">Технология видеопамяти, например GDDR6.</rdfs:comment>
        <rdfs:label xml:lang="ru">Тип памяти</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontologies/videocard#ModelComponent -->

    <owl:Class rdf:about="https://example.org/ontologies/videocard#ModelComponent">
        <rdfs:comment xml:lang="ru">Общий класс для модели GPU, конфигурации видеопамяти и системы охлаждения.</rdfs:comment>
        <rdfs:label xml:lang="ru">Компонент модели</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontologies/videocard#PassiveCooling -->

    <owl:Class rdf:about="https://example.org/ontologies/videocard#PassiveCooling">
        <rdfs:subClassOf rdf:resource="https://example.org/ontologies/videocard#CoolingSystem"/>
        <rdfs:comment xml:lang="ru">Подкласс «Система охлаждения»; охлаждение без вентилятора.</rdfs:comment>
        <rdfs:label xml:lang="ru">Пассивное охлаждение</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontologies/videocard#Purpose -->

    <owl:Class rdf:about="https://example.org/ontologies/videocard#Purpose">
        <rdfs:comment xml:lang="ru">Заявленная область использования модели видеокарты.</rdfs:comment>
        <rdfs:label xml:lang="ru">Назначение</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontologies/videocard#VideoCardModel -->

    <owl:Class rdf:about="https://example.org/ontologies/videocard#VideoCardModel">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/ontologies/videocard#hasCooling"/>
                <owl:allValuesFrom rdf:resource="https://example.org/ontologies/videocard#CoolingSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/ontologies/videocard#hasInterface"/>
                <owl:allValuesFrom rdf:resource="https://example.org/ontologies/videocard#ConnectionInterface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/ontologies/videocard#hasMemory"/>
                <owl:allValuesFrom rdf:resource="https://example.org/ontologies/videocard#MemoryConfiguration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/ontologies/videocard#producedByManufacturer"/>
                <owl:allValuesFrom rdf:resource="https://example.org/ontologies/videocard#Manufacturer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/ontologies/videocard#usesGPU"/>
                <owl:allValuesFrom rdf:resource="https://example.org/ontologies/videocard#GPUModel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/ontologies/videocard#hasVideoOutput"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/ontologies/videocard#hasCooling"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/ontologies/videocard#hasInterface"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
