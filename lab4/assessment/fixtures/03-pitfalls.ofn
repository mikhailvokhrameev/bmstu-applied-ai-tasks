Prefix(:=<https://example.org/ontologies/videocard#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<https://example.org/fixtures/03-pitfalls>
Declaration(Class(:A))
AnnotationAssertion(rdfs:label :A "Понятие A"@ru)
AnnotationAssertion(rdfs:comment :A "Контрольное описание A"@ru)
Declaration(Class(:B))
AnnotationAssertion(rdfs:label :B "Понятие B"@ru)
AnnotationAssertion(rdfs:comment :B "Контрольное описание B"@ru)
Declaration(Class(:C))
AnnotationAssertion(rdfs:label :C "Понятие C"@ru)
AnnotationAssertion(rdfs:comment :C "Контрольное описание C"@ru)
Declaration(Class(:bad_class))
AnnotationAssertion(rdfs:label :bad_class "Понятие bad_class"@ru)
Declaration(ObjectProperty(:p))
AnnotationAssertion(rdfs:label :p "Понятие p"@ru)
AnnotationAssertion(rdfs:comment :p "Контрольное описание p"@ru)
Declaration(DataProperty(:value))
AnnotationAssertion(rdfs:label :value "Понятие value"@ru)
AnnotationAssertion(rdfs:comment :value "Контрольное описание value"@ru)
SubClassOf(:A :B)
SubClassOf(:C :B)
EquivalentClasses(:A ObjectSomeValuesFrom(:p :B))
ObjectPropertyDomain(:p :A)
ObjectPropertyRange(:p :B)
DataPropertyDomain(:value :A)
)
